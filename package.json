{
  "name": "salesforce-metadata-mcp",
  "version": "2.12.0",
  "description": "The only Salesforce MCP with Agentforce, OmniStudio & DevOps Center tools — 228 tools total: objects, flows, Apex (create + read), schema describe, debug logs, permissions, reports, Experience Cloud, Einstein AI.",
  "mcpName": "io.github.semwalajay83-sem/salesforce-metadata-mcp",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
